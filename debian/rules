#!/usr/bin/make -f
%:
	dh $@ --with python3

override_dh_auto_configure:
	:

override_dh_auto_build:
	for po in translations/*/LC_MESSAGES/*.po; do \
	msgfmt "$$po" -o "$${po%.po}.mo"; \
	done

override_dh_auto_test:
	:

override_dh_auto_clean:
	rm -f translations/*/LC_MESSAGES/*.mo

override_dh_auto_install:
	install -D -m 0755 debian/qping.py debian/qping/usr/bin/qping

override_dh_install:
	dh_install
	chmod 0644 debian/qping/usr/share/applications/qping.desktop

override_dh_missing:
	dh_missing --list-missing
